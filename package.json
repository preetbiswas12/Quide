{
  "$schema": "./schema/tsconfig.schema.json",
  "name": "Quide",
  "version": "1.0.0",
  "description": "An always-on-top transparent assistant to help during interviews.",
  "author": "Preet Biswas",
  "license": "MIT",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron . --dev",
    "dev:vite": "vite",
    "dev:full": "cross-env NODE_ENV=development concurrently -k -s first -n VITE,ELECTRON \"vite --port 5180\" \"wait-on http://localhost:5180 && pnpm run electron:dev\"",
    "clean": "rimraf dist dist-electron release",
    "electron:dev": "cross-env NODE_ENV=development tsc -p electron/tsconfig.json && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app:build": " pnpm run clean && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "dist": "rimraf dist dist-electron  && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "electron": "ts-node electron/main.ts"
  },
  "dependencies": {
    "@google/genai": "^0.12.0",
    "@google/generative-ai": "^0.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "dotenv": "^16.5.0",
    "form-data": "^4.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.0.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron": "^1.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.preetbiswas.Quide",
    "productName": "Quide",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "./dist-electron/main.js",
      "NODE_ENV": "production"
    },
      "mac": {
    "target": [
      { "target": "dir", "arch": ["x64", "arm64"] }
    ],
    "icon": "renderer/public/Quide.icns"
  },
    "win": {
      "target": "nsis",
      "icon": "./renderer/public/Quide-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false,
    "afterPack": "./skip-native-rebuild.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Preet121106/Quide"
  },
  "bugs": {
    "url": "https://github.com/Preet121106/Quide/issues"
  },
  "homepage": "https://github.com/Preet121106/Quide#readme"
}
